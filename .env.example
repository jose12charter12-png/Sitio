# Public production URL (set after purchasing/connecting the single domain)
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional Google Tag Manager container. Never use a placeholder ID in production.
NEXT_PUBLIC_GTM_ID=

# AdSense publisher ID, e.g. ca-pub-XXXXXXXXXXXXXXXX (only after approval)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Translation provider credentials belong on the server only; never prefix with NEXT_PUBLIC_.
TRANSLATION_PROVIDER=
TRANSLATION_API_KEY=

# Consent platform integration (configure a certified CMP appropriate to target markets)
NEXT_PUBLIC_CMP_SCRIPT_URL=
